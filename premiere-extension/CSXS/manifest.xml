<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.wedding.songimporter" ExtensionBundleVersion="1.0.0"
  ExtensionBundleName="Wedding Song Importer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  
  <ExtensionList>
    <Extension Id="com.wedding.songimporter.panel" Version="1.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Premiere Pro CS6 up to CC 2026+ -->
      <Host Name="PPRO" Version="[9.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="7.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.wedding.songimporter.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEPEngine>
            <CommandLine>
              <Parameter>--enable-nodejs</Parameter>
              <Parameter>--mixed-context</Parameter>
            </CommandLine>
          </CEPEngine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Wedding Song Importer</Menu>

          <Geometry>
            <Size>
              <Width>380</Width>
              <Height>650</Height>
            </Size>
            <MinSize>
              <Width>320</Width>
              <Height>450</Height>
            </MinSize>
            <MaxSize>
              <Width>800</Width>
              <Height>1200</Height>
            </MaxSize>
          </Geometry>

          <Icons>
            <Icon Type="Normal">./client/icons/icon-normal.png</Icon>
            <Icon Type="DarkNormal">./client/icons/icon-normal.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
